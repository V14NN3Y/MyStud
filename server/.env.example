# Copy to .env and fill in real values before running with NODE_ENV=production.
# In development, every one of these has a safe (clearly-fake) fallback and
# this file is optional.

NODE_ENV=development
PORT=4000

# Signs candidate/institutional session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# HMAC key used to tokenize the NPI (see src/routes/identity.ts). Losing or
# rotating this makes every previously-issued npiToken unrecognizable.
NPI_HMAC_SECRET=

# Signs short-lived document download links. Must be identical across every
# server instance in production, or links minted by one instance will be
# rejected by another.
DOWNLOAD_LINK_SECRET=

# Where the SQLite file and uploaded documents are stored.
DATA_DIR=./data

# Optional. Without it, the e-mail channel just logs to the console instead
# of sending (see src/notifications/channel.ts). Any Resend account's key
# works here, even one created for another project — it isn't scoped to a
# specific project, only to whichever sender domain that account verified.
RESEND_API_KEY=
# "Name <address>" the e-mails appear to come from. Defaults to Resend's
# shared sandbox sender if left empty, which needs no domain verification
# but restricts who Resend will actually deliver to. Switch to an address on
# a domain you've verified in Resend once you have one (e.g. mystud.bj).
RESEND_FROM_EMAIL=MyStud <onboarding@resend.dev>

# Origin allowed to call this API with credentials. Must match exactly
# where the frontend is served from (see vite.config.ts's server.port).
CORS_ORIGIN=http://localhost:3000
